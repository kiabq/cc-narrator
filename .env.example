# Copy to ~/.config/cc-narrator/.env and fill in.
# Environment variables override values in that file.

# Required
ELEVENLABS_API_KEY=
CC_NARRATOR_NARRATOR_VOICE_ID=
CC_NARRATOR_ANNOUNCER_VOICE_ID=

# Optional (defaults shown)
CC_NARRATOR_TTS_MODEL=eleven_flash_v2_5
CC_NARRATOR_NARRATOR_VOLUME=1.0
CC_NARRATOR_ANNOUNCER_VOLUME=0.4
CC_NARRATOR_ENABLED_BY_DEFAULT=true
CC_NARRATOR_ANNOUNCE_MAX_AGE_SECONDS=60
